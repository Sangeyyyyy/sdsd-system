# Local development database (SQLite file via libSQL)
DATABASE_URL=file:data/app.db
# For Turso in production:
# DATABASE_URL=libsql://your-db.turso.io
DATABASE_AUTH_TOKEN=

# Long random string used to sign admin session cookies
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Two admin accounts (created by `npm run db:seed` if missing)
ADMIN1_USERNAME=admin1
ADMIN1_PASSWORD=change-me-1
ADMIN1_NAME=SDSD Admin 1

ADMIN2_USERNAME=admin2
ADMIN2_PASSWORD=change-me-2
ADMIN2_NAME=SDSD Admin 2

NEXT_PUBLIC_SITE_NAME=SDSD Q

# Public origin used for canonical links, the sitemap, and link previews.
# Leave blank on Vercel to fall back to the project's production domain.
NEXT_PUBLIC_SITE_URL=
